# Template for apps/api's environment, in local development or on a deployed
# Fly machine (`fly secrets set`, see docs/DEPLOYMENT.md). No values are
# filled in here; get each one from where its comment says, and never commit
# a file that has real values in it.
#
# apps/api does NOT auto-load a .env file — there is no dotenv dependency in
# this repo. Export these into your actual shell environment before running
# `npm run dev:api` (`$env:NAME = "value"` in PowerShell), or use your own
# tool (direnv, `dotenv-cli`, etc.) if you want file-based loading. The one
# exception is `apps/api/scripts/apply-schema.ts`, which additionally reads
# `DATABASE_URL` out of a `.env.local` at the repo root as a convenience
# fallback — see that script's own header comment.
#
# apps/web is different: Vite auto-loads `.env.local` for VITE_-prefixed
# vars, which is what `.env.local.example` (VITE_MAPBOX_TOKEN only) at the
# repo root is for. This file is the superset used by the API/deployment.

ANTHROPIC_API_KEY=      # console.anthropic.com — generation. Costs real money.

# Supabase → Project Settings → Database → Connection string → use the
# "Connection pooling" / session-mode string (port 5432), NOT the direct
# connection string. The direct-connection host (db.<ref>.supabase.co) is
# IPv6-only; a machine or network without IPv6 (true of at least one machine
# this app was built on) cannot reach it at all — it just hangs or refuses,
# with nothing in the error that says "IPv6". The session pooler host
# resolves over IPv4 too and is a drop-in replacement. This cost real
# debugging time once already; it shouldn't cost any twice.
DATABASE_URL=           # Supabase -> Database -> Connection pooling -> Session mode (port 5432)

# Mapbox public pk. token. Needed in TWO places for a container deploy, not
# one — confirmed by actually running the built image:
#   1. Build time: Vite inlines VITE_-prefixed vars into the static bundle,
#      so the map view needs this passed to `docker build`/`fly deploy` as
#      a build argument (`--build-arg VITE_MAPBOX_TOKEN=...`); `fly secrets
#      set` never reaches it, since that only affects the already-built
#      running container.
#   2. Runtime: the API's own routing stage also reads this var (or
#      MAPBOX_TOKEN) via `resolveMapboxToken()` to call Mapbox Directions
#      server-side — checked at process startup, so the container will not
#      even boot without it. `fly secrets set VITE_MAPBOX_TOKEN=...` (or
#      MAPBOX_TOKEN) IS required for this half.
# Set it both ways; skipping either one breaks something different.
VITE_MAPBOX_TOKEN=      # Mapbox public pk. token, used by the map and by routing
GENERATE_PASSPHRASE=    # any long random string; the service refuses to start without it
DAILY_SPEND_CAP_USD=5   # hard ceiling on generation spend per day
CASSETTE_MODE=replay    # replay | record | live. Default replay: never calls a paid API
LLM_MODE=               # unset (default) = synthetic fixtures, spends nothing.
                        # 'live' reaches Opus 5 and requires ANTHROPIC_API_KEY,
                        # refusing to start without it. Leaving ANTHROPIC_API_KEY
                        # unset is therefore a spending guard, not an oversight.

# --- Voice (Plan 2b). All three needed together, or synthesis is skipped and
# --- tours fall back to the device's own speech.
GOOGLE_TTS_API_KEY=     # Google Cloud console -> enable "Cloud Text-to-Speech API"
                        # -> Credentials -> API key. RESTRICT it to that API, and
                        # note the API must be enabled on the SAME project as the
                        # key: a restricted key reports API_KEY_SERVICE_BLOCKED and
                        # a disabled API reports SERVICE_DISABLED, and having both
                        # wrong shows you only one at a time.
SUPABASE_URL=           # https://<ref>.supabase.co
SUPABASE_SECRET_KEY=    # the sb_secret_... key (Supabase's newer name for what
                        # older docs call the service-role key)

# Requires a PUBLIC bucket named `tour-audio`. Public deliberately: narration is
# read aloud on a street, and signed URLs carry an expiring query string that
# breaks the service worker's .mp3 cache rule and rots any URL stored in a
# saved tour.
